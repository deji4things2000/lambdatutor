# Copy this file to .env and load it with:
#   set -a; source .env; set +a
#
# Never commit .env or replace these placeholders with real credentials.

# Required only for live Dartmouth explanations.
DARTMOUTH_CHAT_API_KEY=

# Dartmouth configuration.
DARTMOUTH_CHAT_URL=https://chat.dartmouth.edu/api/chat/completions
# Leave empty to choose interactively from Dartmouth's /api/models response.
DARTMOUTH_MODEL=

# Optional: set this when Python cannot find a trusted CA bundle.
# Example:
# DARTMOUTH_CA_BUNDLE=/absolute/path/to/certifi/cacert.pem
DARTMOUTH_CA_BUNDLE=
